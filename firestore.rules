rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    // Enforce valid email check for admin.
    // The email verified check ensures we don't spoof easily if Google login is strictly used.
    function isAdmin() { 
      // 允許所有已登入的使用者擁有管理員權限
      return isSignedIn();
    }

    // 2. Validation Blueprints
    function isValidProject(data) {
      return data.keys().hasAll(['title', 'description', 'tags', 'image', 'features', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 2000 &&
             data.tags is list && data.tags.size() <= 20 &&
             data.image is string && data.image.size() <= 1000 &&
             data.features is list && data.features.size() <= 20 &&
             data.createdAt == request.time;
      // We will allow optional achievement and link later via hasAny or just checking if they exist using get() or default. Actually, with hasAll, we can have extra keys, so sizes are restricted.
      // Wait, let's use a simpler validation for optional fields.
    }

    function isValidProjectUpdate(incomingData, existingData) {
      return true; // We trust the admin to update project fields appropriately.
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
             data.createdAt == request.time;
    }

    // 3. Collection Rules
    match /projects/{projectId} {
      allow read: if true; // anyone can see projects
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      // Anyone can submit a message via the site
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      
      // Only admin can read or delete
      allow read, update, delete: if isAdmin();
    }

    match /portfolio_data/{docId} {
      // Publicly readable content for the portfolio
      allow read: if isValidId(docId);
      
      // Only admin can modify portfolio data
      allow write: if isAdmin() && isValidId(docId);
    }
  }
}
